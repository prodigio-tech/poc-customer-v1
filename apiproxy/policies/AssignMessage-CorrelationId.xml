<AssignMessage name="AssignMessage-CorrelationId">
    <DisplayName>AssignMessage-CorrelationId</DisplayName>
    <Properties/>
    <!-- Usa el x-correlation-id del cliente o genera un UUID; viaja al backend y vuelve en la respuesta -->
    <Set>
        <Headers>
            <Header name="x-correlation-id">{firstnonnull(request.header.x-correlation-id,system.uuid)}</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request">request</AssignTo>
</AssignMessage>
